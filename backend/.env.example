APP_NAME="Healthcare Guide AI API"
APP_VERSION="0.1.0"
API_PREFIX="/api"
FRONTEND_ORIGIN="http://localhost:3000"
GEMINI_API_KEY=""
KNOWLEDGE_BASE_PATH="../knowledge-base"
CHROMA_PATH="./data/chroma"
EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSION=768
CHROMA_COLLECTION_NAME="healthcare_guide_documents"
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=5
EMBEDDING_REQUEST_DELAY_SECONDS=6.5
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_COUNT=12
RETRIEVAL_MIN_SIMILARITY=0.62
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=3
GENERATION_MODEL="gemini-3.5-flash"
GENERATION_CONTEXT_TOP_K=3
GENERATION_MAX_OUTPUT_TOKENS=1200
GENERATION_MAX_RETRIES=3
GENERATION_MAX_CONTEXT_CHARACTERS=9000
GENERATION_THINKING_BUDGET=0
CHAT_MAX_QUESTION_LENGTH=1000
CHAT_MAX_HISTORY_MESSAGES=6
